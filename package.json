{
  "name": "kacky-reloaded-project",
  "private": true,
  "type": "module",
  "description": "Kacky Reloaded (Trackmania 2020) TAS tracker: live WRs from Trackmania.io vs TAS runs from TMTAS Exchange.",
  "scripts": {
    "test": "node --test \"tests/*.test.js\"",
    "check": "node scripts/check.mjs",
    "update": "node scripts/update.mjs",
    "sync-sheet": "node scripts/gsheet_sync.mjs",
    "build": "node scripts/build_pages.mjs",
    "serve": "npx --yes serve .",
    "lint": "npx --yes eslint@10 .",
    "bundle": "node scripts/build_pages.mjs && node scripts/bundle.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
